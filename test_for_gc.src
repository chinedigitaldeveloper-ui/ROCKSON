// RUN: success
// EXPECT: Evens sum: 20
// EXPECT: Break reached at: 7
// EXPECT: Heap size before collect is valid
// EXPECT: GC collection cycle finished
int main() {
    int[] nums = new int[5];
    for (int i = 0; i < 5; i = i + 1) {
        nums[i] = (i + 1) * 2; // 2, 4, 6, 8, 10
    }

    // Continue test: accumulate only numbers <= 8
    int sum = 0;
    for (int j = 0; j < nums.length; j = j + 1) {
        if (nums[j] == 10) {
            continue;
        }
        sum = sum + nums[j];
    }
    print("Evens sum: " + sum); // 2 + 4 + 6 + 8 = 20

    // Break test
    for (int k = 0; k < 20; k = k + 1) {
        if (k == 7) {
            print("Break reached at: " + k);
            break;
        }
    }

    // GC Introspection test
    int initial_heap = gc_heap_size();
    if (initial_heap > 0) {
        print("Heap size before collect is valid");
    }

    gc_collect();
    print("GC collection cycle finished");

    return 0;
}
