// RUN: module

// --- Integer Array Operations ---

// Transforms each element using a function pointer
int[] map_int(int[] src, int(int) transform) {
    int[] res = new int[src.length];
    for (int i = 0; i < src.length; i = i + 1) {
        res[i] = transform(src[i]);
    }
    return res;
}

// Filters elements matching predicate (returning 1/non-zero)
int[] filter_int(int[] src, int(int) predicate) {
    int count = 0;
    for (int i = 0; i < src.length; i = i + 1) {
        if (predicate(src[i]) != 0) {
            count = count + 1;
        }
    }
    int[] res = new int[count];
    int idx = 0;
    for (int i = 0; i < src.length; i = i + 1) {
        if (predicate(src[i]) != 0) {
            res[idx] = src[i];
            idx = idx + 1;
        }
    }
    return res;
}

// Left-fold / reduce over an integer array
int fold_int(int[] src, int initial, int(int,int) accumulator) {
    int acc = initial;
    for (int i = 0; i < src.length; i = i + 1) {
        acc = accumulator(acc, src[i]);
    }
    return acc;
}

// Iterates and executes an action for each element
void for_each_int(int[] src, void(int) action) {
    for (int i = 0; i < src.length; i = i + 1) {
        action(src[i]);
    }
}

// Returns 1 if any element satisfies predicate, 0 otherwise
int any_int(int[] src, int(int) predicate) {
    for (int i = 0; i < src.length; i = i + 1) {
        if (predicate(src[i]) != 0) {
            return 1;
        }
    }
    return 0;
}

// Returns 1 if all elements satisfy predicate, 0 otherwise
int all_int(int[] src, int(int) predicate) {
    for (int i = 0; i < src.length; i = i + 1) {
        if (predicate(src[i]) == 0) {
            return 0;
        }
    }
    return 1;
}

// Slices an integer array from start to end (exclusive)
int[] slice_int(int[] src, int start, int end) {
    if (start < 0) {
        start = 0;
    }
    if (end > src.length) {
        end = src.length;
    }
    if (start >= end) {
        return new int[0];
    }
    int len = end - start;
    int[] res = new int[len];
    for (int i = 0; i < len; i = i + 1) {
        res[i] = src[start + i];
    }
    return res;
}

// --- String Array Operations ---

// Transforms each string element using a function pointer
string[] map_string(string[] src, string(string) transform) {
    string[] res = new string[src.length];
    for (int i = 0; i < src.length; i = i + 1) {
        res[i] = transform(src[i]);
    }
    return res;
}

// Iterates and executes an action for each string element
void for_each_string(string[] src, void(string) action) {
    for (int i = 0; i < src.length; i = i + 1) {
        action(src[i]);
    }
}

// Slices a string array from start to end (exclusive)
string[] slice_string(string[] src, int start, int end) {
    if (start < 0) {
        start = 0;
    }
    if (end > src.length) {
        end = src.length;
    }
    if (start >= end) {
        return new string[0];
    }
    int len = end - start;
    string[] res = new string[len];
    for (int i = 0; i < len; i = i + 1) {
        res[i] = src[start + i];
    }
    return res;
}

// Joins an array of strings with a separator
string join_strings(string[] src, string sep) {
    if (src.length == 0) {
        return "";
    }
    string res = src[0];
    for (int i = 1; i < src.length; i = i + 1) {
        res = res + sep + src[i];
    }
    return res;
}
