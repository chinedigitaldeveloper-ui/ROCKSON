#!/usr/bin/env python3
import sys
import subprocess
import os
from module_loader import ModuleLoader, ModuleError
from typechecker import TypeChecker, TypeError
from codegen import CodeGenerator

def main():
    if len(sys.argv) < 2:
        print("Usage: ./myc <source_file> [-o <output_binary>] [--emit-c]")
        sys.exit(1)

    src_path = sys.argv[1]
    out_bin = "a.out"
    emit_c = False

    idx = 2
    while idx < len(sys.argv):
        if sys.argv[idx] == "-o" and idx + 1 < len(sys.argv):
            out_bin = sys.argv[idx + 1]
            idx += 2
        elif sys.argv[idx] == "--emit-c":
            emit_c = True
            idx += 1
        else:
            idx += 1

    # 1. Module Loading, Recursive Resolution & Parsing
    try:
        loader = ModuleLoader()
        ast = loader.load(src_path)
    except ModuleError as e:
        print(f"[myc: Module Error] {e}")
        sys.exit(1)
    except SyntaxError as e:
        print(f"[myc: Syntax Error] {e}")
        sys.exit(1)

    # 2. Type Checking & Semantic Analysis across all modules
    try:
        checker = TypeChecker(ast)
        checker.check()
    except TypeError as e:
        print(f"[myc: Type Error] {e}")
        sys.exit(1)

    # 3. Code Generation (VTable Dynamic Dispatch + Memory Safety)
    codegen = CodeGenerator(ast)
    c_code = codegen.generate()

    tmp_c_file = f"{src_path}.tmp.c"
    with open(tmp_c_file, "w") as f:
        f.write(c_code)

    if emit_c:
        c_debug_name = f"{os.path.splitext(src_path)[0]}.c"
        with open(c_debug_name, "w") as f:
            f.write(c_code)
        print(f"[myc] Emitted C code: {c_debug_name}")

    # 4. Native compilation with libgc
    cmd = ["gcc", tmp_c_file, "-lgc", "-o", out_bin]
    result = subprocess.run(cmd)

    if os.path.exists(tmp_c_file):
        os.remove(tmp_c_file)

    if result.returncode != 0:
        print("[myc] Backend C compilation failed.")
        sys.exit(result.returncode)

    print(f"[myc] Build successful -> ./{out_bin}")

if __name__ == "__main__":
    main()
